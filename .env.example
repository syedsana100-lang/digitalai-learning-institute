# Copy this file to .env.local and fill in real values before deploying.
# Nothing in this project ships with real credentials or fake placeholder IDs.

NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@yourdomain.com
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Analytics — GTM defaults to GTM-NQQG8RB9 in code (lib/site-config.ts) even if left
# blank here; set this only if you need to override it for a different environment.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Sanity CMS — required to activate the /studio admin panel and CMS-driven
# blog/course/FAQ content. Until these are set, the site runs entirely on the
# static content in lib/. See sanity/README.md for full setup steps.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
# Only needed if you later add write/preview features (not required for the
# read-only CMS wiring shipped here):
# SANITY_API_TOKEN=
