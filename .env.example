# Copy this file to .env.local and fill in real values before deploying.
# Nothing in this project ships with real credentials or fake placeholder IDs.

NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@yourdomain.com
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Analytics — leave blank until you have real IDs. The site works fine without them.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Sanity CMS — see sanity/README.md
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# --- Student Portal / LMS — see docs/LMS-SETUP.md for step-by-step setup ---

# Postgres connection string. Works with Supabase, Neon, or Vercel Postgres —
# any standard Postgres connection string. Get this from your database
# provider's dashboard after creating a free project.
DATABASE_URL=

# Auth.js session encryption secret. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=

# Google Sign-In (optional) — create an OAuth Client ID at
# https://console.cloud.google.com/apis/credentials. Leave blank to disable
# the "Continue with Google" button; email/password sign-up still works.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Vercel Blob (private document/certificate storage). Create a Blob store
# from the Storage tab of your Vercel project — it gives you this token
# directly. Free on the Hobby plan.
BLOB_READ_WRITE_TOKEN=
